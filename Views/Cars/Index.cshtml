@model List<CarRental.Models.Car>

<div class="d-flex justify-content-between align-items-center mb-4">
	<div>
		<h1>Available Cars</h1>
		<p class="text-muted">Select a car to book it.</p>
	</div>
	<div>
		<a class="btn btn-outline-secondary" href="/Cars/Booked">View Booked Cars</a>
	</div>
</div>

@if (Model != null && Model.Any())
{
	<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
		@foreach (var car in Model)
		{
			<div class="col">
				<div class="card h-100 shadow-sm">
					<div class="card-body d-flex flex-column">
						<h5 class="card-title">@car.Name</h5>
						<p class="card-text mb-2">Price per day: <strong>PKR @String.Format("{0:N0}", car.PricePerDay)</strong></p>
						<span class="badge bg-success mb-3 align-self-start">Available</span>

						<div class="mt-auto w-100">
							<form asp-action="Book" method="post">
								@Html.AntiForgeryToken()
								<input type="hidden" name="id" value="@car.Id" />
								<button type="submit" class="btn btn-primary w-100">Book Car</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		}
	</div>
}
else
{
	<div class="alert alert-info">No cars are currently available.</div>
}
